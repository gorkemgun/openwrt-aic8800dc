diff --git a/drivers/aic8800/aic8800_fdrv/Makefile b/drivers/aic8800/aic8800_fdrv/Makefile
index e757664..06b1ac2 100644
--- a/drivers/aic8800/aic8800_fdrv/Makefile
+++ b/drivers/aic8800/aic8800_fdrv/Makefile
@@ -294,6 +294,11 @@ ccflags-$(CONFIG_PREALLOC_RX_SKB) += -DCONFIG_PREALLOC_RX_SKB
 ccflags-$(CONFIG_PREALLOC_TXQ) += -DCONFIG_PREALLOC_TXQ
 ccflags-$(CONFIG_USE_WIRELESS_EXT) += -DCONFIG_USE_WIRELESS_EXT
 
+# Version of the cfg80211 API the driver is built against. It differs from the
+# kernel version when cfg80211 comes from backports (e.g. OpenWrt).
+AIC_WIRELESS_VERSION_CODE ?= LINUX_VERSION_CODE
+ccflags-y += -DAIC_WIRELESS_VERSION_CODE=$(AIC_WIRELESS_VERSION_CODE)
+
 CFG80211_HDR := $(srctree)/include/net/cfg80211.h
 ifneq ($(wildcard $(CFG80211_HDR)),)
 ifneq ($(shell grep -A1 '(\*set_monitor_channel)' $(CFG80211_HDR) | grep -c 'struct net_device'),0)
diff --git a/drivers/aic8800/aic8800_fdrv/rwnx_defs.h b/drivers/aic8800/aic8800_fdrv/rwnx_defs.h
